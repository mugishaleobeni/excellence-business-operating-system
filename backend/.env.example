# ExBOS Flask + MongoDB Atlas Backend Configuration
FLASK_ENV=development
PORT=5000
SECRET_KEY=exbos-super-secret-key-change-in-production-2026
JWT_SECRET_KEY=exbos-jwt-signing-secret-key-change-in-production-2026
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# MongoDB Atlas Connection URI (replace with your MongoDB Atlas SRV URI in production)
MONGO_URI=mongodb://localhost:27017/exbos_db
MONGO_DB_NAME=exbos_db

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

